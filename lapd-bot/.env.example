# Copy this file to ".env" and fill in the values. Never commit .env.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# The Discord server the bot runs in (LAPD server ID). Slash commands register here instantly.
GUILD_ID=

# Optional: port for the web status page. RRHosting sets SERVER_PORT automatically,
# so you normally leave this blank.
# PORT=8080
