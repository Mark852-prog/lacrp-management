# Copy this file to ".env" and fill in the values. Never commit .env.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# YOUR Discord user ID - the only person who can use /setup, /announcement add/edit/remove and /quota set.
# (Discord: Settings > Advanced > Developer Mode on, then right-click your name > Copy User ID)
BOT_OWNER_ID=

# LACRP Discord server ID
GUILD_ID=1535653403815059546

# ER:LC private server key (in-game: Settings > Private Server > API)
ERLC_SERVER_KEY=

# Bloxlink server API key (https://blox.link/dashboard > your server > Developer)
BLOXLINK_API_KEY=

# Optional: where the SQLite database lives (default ./data/lacrp.db)
# DATABASE_PATH=./data/lacrp.db
